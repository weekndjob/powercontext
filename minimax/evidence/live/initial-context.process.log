{"project_id": "demo_86522fcec0e848c1aa3fdd88f179363a", "query": "archive", "sources": [{"path": "taskboard.py", "kind": "code", "status": "active", "sha256": "78c0aacd0c355066d1b5fdfdd978b84a6f881a232b1ca11c1b5a4f1140e7b82e", "body": "\"\"\"A small existing taskboard query module with an archive visibility bug.\"\"\"\n\n\ndef list_tasks(tasks, status=None, *, include_archived=False):\n    \"\"\"Return matching tasks in input order; archive filtering needs repair.\"\"\"\n    return [task for task in tasks if status is None or task[\"status\"] == status]\n", "score": 0.20872865275142316}, {"path": "specs/archive_policy.md", "kind": "spec", "status": "active", "sha256": "1321d46c3b99e5fda8bcd35694ae0f651c875fa8f6398fb5f53e688145bbdd04", "body": "# ARCHIVE-002: current archive visibility contract\n\nStatus: active. Supersedes ARCHIVE-001.\n\nTask: fix the archive filter in taskboard.list_tasks.\n\n- R1: With include_archived=False (the default), exclude every archived row.\n- R2: With include_archived=True, allow archived and non-archived rows.\n- R3: A non-None status is an additional intersection filter, including when\n  include_archived=True. An archived row must not bypass the status filter.\n- C1: Preserve input order, return a fresh list, and do not modify input rows.\n- C2: Preserve empty-input behavior and the existing status=None behavior.\n\nTarget tests: tests/test_archive.py. Compatibility: tests/test_compatibility.py.\nImplementation: taskboard.py::list_tasks.\n", "score": 0.1943462897526502}, {"path": "tests/test_compatibility.py", "kind": "test", "status": "active", "sha256": "256ccb229a9fc27162a56a74ffe7d00981243aec20daf1dfce9e200e28ac7968", "body": "\"\"\"Archive change must preserve the taskboard's existing query behavior.\"\"\"\nfrom copy import deepcopy\nfrom taskboard import list_tasks\n\n\ndef test_archive_empty_input_is_still_empty():\n    assert list_tasks([]) == []\n\n\ndef test_archive_change_preserves_status_filter_for_visible_rows():\n    rows = [{\"id\": 1, \"status\": \"open\", \"archived\": False},\n            {\"id\": 2, \"status\": \"done\", \"archived\": False}]\n    assert list_tasks(rows, status=\"done\") == [rows[1]]\n    assert list_tasks(rows, status=\"missing\") == []\n\n\ndef test_archive_change_preserves_order_and_does_not_mutate_inputs():\n    rows = [{\"id\": 9, \"status\": \"open\", \"archived\": False},\n            {\"id\": 3, \"status\": \"done\", \"archived\": False}]\n    before = deepcopy(rows)\n    actual = list_tasks(rows)\n    assert actual == before\n    assert actual is not rows\n    assert rows == before\n", "score": 0.07503410641200546}, {"path": "tests/test_archive.py", "kind": "test", "status": "active", "sha256": "86d75a108f68f7bca7b6e04290501ee0e6928ddf2e546a88692354f75308fedb", "body": "\"\"\"Target behavior from ARCHIVE-002; identical tests run before and after.\"\"\"\nfrom taskboard import list_tasks\n\n\nROWS = [\n    {\"id\": 1, \"status\": \"open\", \"archived\": False},\n    {\"id\": 2, \"status\": \"open\", \"archived\": True},\n    {\"id\": 3, \"status\": \"done\", \"archived\": False},\n    {\"id\": 4, \"status\": \"done\", \"archived\": True},\n]\n\n\ndef test_archive_is_excluded_by_default():\n    assert [row[\"id\"] for row in list_tasks(ROWS)] == [1, 3]\n\n\ndef test_explicit_false_also_excludes_archive():\n    assert [row[\"id\"] for row in list_tasks(ROWS, include_archived=False)] == [1, 3]\n\n\ndef test_archive_status_filter_is_an_intersection():\n    assert [row[\"id\"] for row in list_tasks(ROWS, status=\"open\")] == [1]\n\n\ndef test_archive_can_be_explicitly_included():\n    assert [row[\"id\"] for row in list_tasks(ROWS, include_archived=True)] == [1, 2, 3, 4]\n\n\ndef test_including_archive_does_not_bypass_status():\n    assert [row[\"id\"] for row in list_tasks(ROWS, status=\"done\", include_archived=True)] == [3, 4]\n", "score": 0.06832298136645962}], "fingerprints": {"specs/archive_policy.md": "1321d46c3b99e5fda8bcd35694ae0f651c875fa8f6398fb5f53e688145bbdd04", "specs/archive_policy_legacy.md": "8d89653090bb1eccede8858b53d2802ceb50d5318d64887024823a1e2e10fb74", "taskboard.py": "78c0aacd0c355066d1b5fdfdd978b84a6f881a232b1ca11c1b5a4f1140e7b82e", "tests/test_archive.py": "86d75a108f68f7bca7b6e04290501ee0e6928ddf2e546a88692354f75308fedb", "tests/test_compatibility.py": "256ccb229a9fc27162a56a74ffe7d00981243aec20daf1dfce9e200e28ac7968", "@manifest": "e70be35298a4e9ec58eac210d74732c45b458ac16037c44abbaf6a62f7fd0fc3"}, "task_id": "archive-filter", "progress": {"state": null, "pid": 34412}}
