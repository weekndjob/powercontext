    "results": [
      {
        "id": "950539fb2956d4e22d3b2302e5444eedf0b4826a256fb73dce390f5573fd444a",
        "text": "The starisland zephyr protocol is a unique marker for testing newly imported document visibility.",
        "metadata": {
          "chunk": 0,
          "model": "Xenova/all-MiniLM-L6-v2",
          "title": "incremental.txt",
          "source": "incremental.txt",
          "revision": "751bff37182d3f1213fa05d7196b954e230abad9"
        },
        "score": 0.0328
      },
      {
        "id": "13982cc898c6073b06bf400811ab8f22e58453dd611f68c1b77a27eb1a245b1a",
        "text": "The lantern meadow token verifies browser file upload and local document embedding.",
        "metadata": {
          "chunk": 0,
          "model": "Xenova/all-MiniLM-L6-v2",
          "title": "browser-file.txt",
          "source": "browser-file.txt",
          "revision": "751bff37182d3f1213fa05d7196b954e230abad9"
        },
        "score": 0.0161
      },
      {
        "id": "d18",
        "text": "The first browser request includes model file transfer, session creation, and runtime initialization. Later requests can reuse downloaded weights and a warm inference session. Report first-load and warm-request timings separately.",
        "metadata": {
          "chunk": 0,
          "model": "Xenova/all-MiniLM-L6-v2",
          "title": "Cold and warm runs",
          "source": "Cold and warm runs",
          "revision": "751bff37182d3f1213fa05d7196b954e230abad9"
        },
        "score": 0.0159
      },
      {
        "id": "d24",
        "text": "A reproducible performance experiment records device, browser version, model precision, backend, batch size, corpus, query set, and database configuration. Save all raw observations and report medians rather than selecting the fastest run.",
        "metadata": {
          "chunk": 0,
          "model": "Xenova/all-MiniLM-L6-v2",
          "title": "Reproducible experiments",
          "source": "Reproducible experiments",
          "revision": "751bff37182d3f1213fa05d7196b954e230abad9"
        },
        "score": 0.0156
      },
      {
        "id": "d30",
        "text": "WASM threads can speed CPU inference when the page is cross-origin isolated. COOP and COEP headers enable SharedArrayBuffer in compatible browsers. Thread count should be recorded because it affects fair performance comparisons.",
        "metadata": {
          "chunk": 0,
          "model": "Xenova/all-MiniLM-L6-v2",
          "title": "CPU parallelism",
          "source": "CPU parallelism",
          "revision": "751bff37182d3f1213fa05d7196b954e230abad9"
        },
        "score": 0.0154
      }
    ],
    "embeddingMs": 26.264999866485596,
