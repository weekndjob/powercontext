# Default: embedded seekdb, no separate server. Native binding downloads at first launch.
SEEKDB_PATH=.data/seekdb
SEEKDB_DATABASE=stepfun
HOST=127.0.0.1
PORT=4173
# To use a local server, set these instead of relying on embedded mode:
# SEEKDB_HOST=127.0.0.1
# SEEKDB_PORT=2881
# SEEKDB_USER=root
# SEEKDB_PASSWORD=
