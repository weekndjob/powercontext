{
  "name": "stepfun-local-knowledge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs --dev",
    "build": "vite build && node scripts/copy-runtime.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "models": "python3 scripts/download_models.py",
    "test": "node --test tests/*.test.mjs",
    "benchmark": "node scripts/browser-benchmark.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "express": "5.1.0",
    "seekdb": "1.4.0"
  },
  "devDependencies": {
    "vite": "7.1.12",
    "playwright": "1.56.1"
  }
}
